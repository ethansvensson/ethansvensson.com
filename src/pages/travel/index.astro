---
import Layout from '../../components/Layout.astro';
import TripCard from '../../components/TripCard.astro';
import CircleCarousel from '../../components/CircleCarousel.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../data/site';

const trips = (await getCollection('trips')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const circlePhotos = trips
  .flatMap((t) => (t.data.circlePhotos.length > 0 ? t.data.circlePhotos : t.data.gallery))
  .filter((src) => /\.(jpe?g|png|webp)(\?|$)/i.test(src))
  .slice(0, 9)
  .map(withBase);
---

<Layout
  title="Travel"
  description="Places I have traveled"
>
  <section class="section">
    <div class="container">
      <div class="travel-head">
        <div>
          <p class="eyebrow">Travel</p>
          <h1>Where I've been</h1>
          <p class="muted" style="max-width: 60ch; margin: 0;">
          </p>
        </div>
      </div>

      {trips.length > 0 ? (
        <div class="trip-grid" style="margin-top: 2.5rem;">
          {trips.map((t) => <TripCard trip={t} />)}
        </div>
      ) : (
        <p class="muted" style="margin-top: 2rem;">First travel notes are being written…</p>
      )}
    </div>
  </section>
</Layout>
